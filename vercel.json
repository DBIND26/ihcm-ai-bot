{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/parse-2567.js": {
      "maxDuration": 60
    },
    "api/cron-cms-surveys.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/parse-2567", "destination": "/api/parse-2567" }
  ],
  "crons": [
    {
      "path": "/api/cron-cms-surveys",
      "schedule": "0 6 1 * *"
    }
  ]
}
